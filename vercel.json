{
    "version": 2,
    "builds": [
      {
        "src": "frontend/package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": "dist" }
      },
      {
        "src": "backend/**/*.js",
        "use": "@vercel/node"
      }
    ],
    "rewrites": [
      {
        "source": "/backend/(.*)",
        "destination": "/backend"
      },
      {
        "source": "/(.*)",
        "destination": "/frontend/index.html"
      }
    ]
  }